PORT=8080
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173
# Firebase project id (from console -> Project settings)
FIREBASE_PROJECT_ID=milkgo-db
# Local dev: path to a service-account JSON downloaded from
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# On Google Cloud (Cloud Run / Functions) leave empty: credentials are automatic.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
