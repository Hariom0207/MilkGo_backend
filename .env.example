PORT=8080
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Firebase project id (from console -> Project settings)
FIREBASE_PROJECT_ID=milkgo-db
# Local dev: path to a service-account JSON downloaded from
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# On Google Cloud (Cloud Run / Functions) leave empty: credentials are automatic.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Web API key (public) used only by scripts/get-token.ts for local testing
FIREBASE_WEB_API_KEY=AIzaSyDHjLs3g2Aki_VCux8sjY8wJ8mLVJvxfsw

# Emails that auto-become admin on login (comma-separated)
ADMIN_EMAILS=
